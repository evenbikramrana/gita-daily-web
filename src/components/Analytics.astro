---
// Google Analytics 4. Rendered only in production builds and only when a
// Measurement ID is configured, so dev/preview never pollute the data and the
// site ships zero tracking until you opt in by setting the ID in config.ts.
import { GA_MEASUREMENT_ID } from '../config';

const enabled = import.meta.env.PROD && GA_MEASUREMENT_ID.length > 0;
const id = GA_MEASUREMENT_ID;
---

{
  enabled && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        // anonymize_ip keeps this aligned with the privacy-forward brand.
        gtag('config', id, { anonymize_ip: true });
        // "Get the app" clicks — the website's main conversion. Mark get_app_click as a key event
        // in GA4 (Admin → Events) and compare placements (home / verse / chapter / gita-index).
        document.addEventListener('click', function (e) {
          var a = e.target.closest && e.target.closest('a[data-cta]');
          if (!a) return;
          gtag('event', 'get_app_click', {
            placement: a.getAttribute('data-cta'),
            page_path: location.pathname,
            transport_type: 'beacon',
          });
        });
      </script>
    </>
  )
}
