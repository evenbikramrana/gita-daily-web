---
// One consistent line-icon set (stroke, 24-grid, currentColor) so nothing looks
// mismatched. Color + size are controlled by the parent via CSS / the size prop.
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 24, class: cls = '' } = Astro.props;

const PATHS: Record<string, string> = {
  compass: '<circle cx="12" cy="12" r="9"/><path d="M15.6 8.4l-2.3 4.9-4.9 2.3 2.3-4.9z"/>',
  book: '<path d="M12 6.6C10.4 5.3 8 4.6 5.3 4.6H3v12.8h2.3c2.7 0 5.1.7 6.7 2 1.6-1.3 4-2 6.7-2H21V4.6h-2.3c-2.7 0-5.1.7-6.7 2z"/><path d="M12 6.6v12.8"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.5 2.7 3.9 6 3.9 9s-1.4 6.3-3.9 9c-2.5-2.7-3.9-6-3.9-9S9.5 5.7 12 3z"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/>',
  bookmark: '<path d="M6.5 3.5h11a1 1 0 0 1 1 1V21l-6.5-3.8L5.5 21V4.5a1 1 0 0 1 1-1z"/>',
  leaf: '<path d="M5 21C5 12 10.5 4.5 20 4.5 20 14 13 21 5 21z"/><path d="M5 21C8.5 15.5 13 11.5 18 9"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
};
const d = PATHS[name] ?? '';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cls}
  aria-hidden="true"
  set:html={d}
></svg>
