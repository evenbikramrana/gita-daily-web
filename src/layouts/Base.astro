---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

export interface Props {
  title: string;
  description: string;
  /** Page-specific JSON-LD (object or array). Falls back to a WebSite schema. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description, schema } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p = '') => (base.endsWith('/') ? base : base + '/') + p;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(withBase('og.png'), Astro.site).href;

const nav = [
  { href: withBase(''), label: 'Home' },
  { href: withBase('gita'), label: 'Read the Gita' },
  { href: withBase('support'), label: 'Support' },
];

const defaultSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Gita Daily',
  url: new URL(base, Astro.site).href,
};
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [defaultSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Apply the saved theme before paint to avoid a flash of the wrong theme. -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#E5731F" />
    <meta name="generator" content={Astro.generator} />

    <!-- Brand fonts (same as the app): Bricolage Grotesque + Noto Serif Devanagari -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..700&family=Noto+Serif+Devanagari:wght@400..600&display=swap"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gita Daily" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={withBase('')} aria-label="Gita Daily home">
          <svg viewBox="0 0 100 100" aria-hidden="true">
            <g>
              <path d="M50 78 C36 60 30 42 22 46 C26 64 38 74 50 78 Z" fill="#4E8F86" />
              <path d="M50 78 C64 60 70 42 78 46 C74 64 62 74 50 78 Z" fill="#4E8F86" />
              <path d="M50 78 C42 56 44 34 50 26 C56 34 58 56 50 78 Z" fill="#E5731F" />
            </g>
          </svg>
          Gita Daily
        </a>
        <div class="header-right">
          <nav class="nav" id="site-nav">
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
          </nav>
          <button class="icon-btn theme-toggle" type="button" aria-label="Switch light or dark theme">
            <Icon name="sun" size={20} class="i-light" />
            <Icon name="moon" size={20} class="i-dark" />
          </button>
          <button
            class="icon-btn menu-btn"
            type="button"
            aria-label="Menu"
            aria-expanded="false"
            aria-controls="site-nav"
          >
            <Icon name="menu" size={22} class="i-menu" />
            <Icon name="close" size={22} class="i-close" />
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Gita Daily · The Bhagavad Gita, free to read.</span>
        <nav class="nav">
          <a href={withBase('privacy')}>Privacy</a>
          <a href={withBase('support')}>Support</a>
        </nav>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // Theme toggle
        var tt = document.querySelector('.theme-toggle');
        if (tt) {
          tt.addEventListener('click', function () {
            var cur = document.documentElement.getAttribute('data-theme');
            var resolved =
              cur ||
              (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light');
            var next = resolved === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        }
        // Mobile menu
        var mb = document.querySelector('.menu-btn');
        var nav = document.getElementById('site-nav');
        if (mb && nav) {
          mb.addEventListener('click', function () {
            var open = nav.classList.toggle('open');
            mb.setAttribute('aria-expanded', String(open));
          });
          nav.addEventListener('click', function (e) {
            if (e.target.tagName === 'A') {
              nav.classList.remove('open');
              mb.setAttribute('aria-expanded', 'false');
            }
          });
        }

        // Gentle scroll reveal
        var reveals = document.querySelectorAll('.reveal');
        if ('IntersectionObserver' in window && reveals.length) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (en) {
                if (en.isIntersecting) {
                  en.target.classList.add('in');
                  io.unobserve(en.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          reveals.forEach(function (el) { io.observe(el); });
        } else {
          reveals.forEach(function (el) { el.classList.add('in'); });
        }
      })();
    </script>
  </body>
</html>
