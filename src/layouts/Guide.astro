---
import Base from './Base.astro';
import { playUrl } from '../config';

export interface Props {
  title: string;
  description: string;
  slug: string;
  /** ISO date, e.g. '2026-09-17' */
  datePublished: string;
  dateModified?: string;
  /** Optional FAQ — rendered on-page and as FAQPage structured data (AEO). */
  faq?: { q: string; a: string }[];
}
const { title, description, slug, datePublished, dateModified, faq } = Astro.props;
const hasFaq = Array.isArray(faq) && faq.length > 0;
const base = import.meta.env.BASE_URL;
const withBase = (p = '') => (base.endsWith('/') ? base : base + '/') + p;
const site = (Astro.site?.href ?? 'https://gitadaily.org/').replace(/\/$/, '');
const url = `${site}/guides/${slug}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: 'en',
    datePublished,
    dateModified: dateModified ?? datePublished,
    author: { '@type': 'Organization', name: 'Gita Daily', url: site },
    publisher: {
      '@type': 'Organization',
      name: 'Gita Daily',
      url: site,
      logo: { '@type': 'ImageObject', url: `${site}/og.png` },
    },
    about: { '@type': 'Book', name: 'The Bhagavad Gita', url: `${site}/gita` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/guides` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];

if (hasFaq) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq!.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<Base title={`${title} — Gita Daily`} description={description} schema={schema}>
  <article class="wrap prose guide">
    <nav class="breadcrumb">
      <a href={withBase('')}>Home</a> › <a href={withBase('guides')}>Guides</a> › {title}
    </nav>
    <h1>{title}</h1>
    <slot />
    {
      hasFaq && (
        <section class="faq">
          <h2>Common questions</h2>
          {faq!.map((f) => (
            <div class="faq-item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </section>
      )
    }
    <div class="app-cta">
      <h3>A verse for how you feel, every day</h3>
      <p>Open Gita Daily, choose how you feel — anxious, heavy, restless, angry — and a verse meets you there. Save the ones that help, and get a gentle verse each morning. Free.</p>
      <div class="app-cta-btns">
        <a class="btn btn-primary" href={playUrl(`guide-${slug}`)} data-cta={`guide-${slug}`} target="_blank" rel="noopener">Get Gita Daily on Google Play</a>
        <a class="app-cta-alt" href={withBase('gita')}>or keep reading online →</a>
      </div>
    </div>
  </article>
</Base>

<style>
  .guide h2 { margin-top: var(--s6); }
  .guide p { line-height: 1.75; }
  .guide blockquote {
    margin: var(--s6) 0;
    padding: var(--s4) var(--s5);
    border-left: 3px solid var(--accent);
    background: var(--band);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .guide blockquote p { margin: 0; color: var(--ink); font-size: 1.15rem; line-height: 1.55; }
  .guide blockquote cite { display: block; margin-top: 10px; font-style: normal; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .guide blockquote cite a { color: var(--accent); }

  .faq { margin-top: var(--s8); padding-top: var(--s6); border-top: 1.5px solid var(--line-strong); }
  .faq > h2 { margin-top: 0; }
  .faq-item { margin-top: var(--s5); }
  .faq-item h3 { margin: 0 0 var(--s2); font-size: 1.15rem; color: var(--ink); }
  .faq-item p { margin: 0; color: var(--muted); line-height: 1.7; max-width: 68ch; }
</style>
