---
import Base from './Base.astro';

export interface Props {
  title: string;
  description: string;
  slug: string;
  /** ISO date, e.g. '2026-09-17' */
  datePublished: string;
  dateModified?: string;
}
const { title, description, slug, datePublished, dateModified } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (p = '') => (base.endsWith('/') ? base : base + '/') + p;
const site = (Astro.site?.href ?? 'https://gitadaily.org/').replace(/\/$/, '');
const url = `${site}/guides/${slug}`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    url,
    mainEntityOfPage: url,
    inLanguage: 'en',
    datePublished,
    dateModified: dateModified ?? datePublished,
    author: { '@type': 'Organization', name: 'Gita Daily', url: site },
    publisher: {
      '@type': 'Organization',
      name: 'Gita Daily',
      url: site,
      logo: { '@type': 'ImageObject', url: `${site}/og.png` },
    },
    about: { '@type': 'Book', name: 'The Bhagavad Gita', url: `${site}/gita` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/guides` },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
];
---

<Base title={`${title} — Gita Daily`} description={description} schema={schema}>
  <article class="wrap prose guide">
    <nav class="breadcrumb">
      <a href={withBase('')}>Home</a> › <a href={withBase('guides')}>Guides</a> › {title}
    </nav>
    <h1>{title}</h1>
    <slot />
    <div class="app-cta">
      <h3>Read by how you feel</h3>
      <p>Gita Daily meets you where you are — choose a mood and get a verse for the moment, plus a verse each day. The whole Gita, free.</p>
      <a class="btn btn-primary" href={withBase('gita')}>Read the Gita free</a>
    </div>
  </article>
</Base>

<style>
  .guide h2 { margin-top: var(--s6); }
  .guide p { line-height: 1.75; }
  .guide blockquote {
    margin: var(--s6) 0;
    padding: var(--s4) var(--s5);
    border-left: 3px solid var(--accent);
    background: var(--band);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }
  .guide blockquote p { margin: 0; color: var(--ink); font-size: 1.15rem; line-height: 1.55; }
  .guide blockquote cite { display: block; margin-top: 10px; font-style: normal; font-weight: 700; font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .guide blockquote cite a { color: var(--accent); }
</style>
