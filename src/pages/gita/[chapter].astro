---
import Base from '../../layouts/Base.astro';
import data from '../../data/gita.json';
import { chapterIntros } from '../../data/chapterIntros';

export function getStaticPaths() {
  return data.chapters.map((c) => ({ params: { chapter: String(c.number) }, props: { chapter: c } }));
}

const { chapter } = Astro.props;
const ci = chapterIntros[chapter.number];
const base = import.meta.env.BASE_URL;
const withBase = (p = '') => (base.endsWith('/') ? base : base + '/') + p;

const prev = chapter.number > 1 ? data.chapters[chapter.number - 2] : null;
const next = chapter.number < data.chapters.length ? data.chapters[chapter.number] : null;

const title = `Bhagavad Gita Chapter ${chapter.number}: ${chapter.en} — all ${chapter.verseCount} verses`;
const description = `Read Bhagavad Gita Chapter ${chapter.number} (${chapter.title} · ${chapter.en}) in full — original Sanskrit with English, Hindi and Nepali translations and context. ${chapter.theme}.`;

const site = (Astro.site?.href ?? 'https://gitadaily.org/').replace(/\/$/, '');
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Read the Gita', item: `${site}/gita` },
      { '@type': 'ListItem', position: 3, name: `Chapter ${chapter.number}`, item: `${site}/gita/${chapter.number}` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: `Bhagavad Gita, Chapter ${chapter.number}: ${chapter.en}`,
    alternateName: chapter.title,
    url: `${site}/gita/${chapter.number}`,
    inLanguage: ['sa', 'en', 'hi', 'ne'],
    isPartOf: { '@type': 'Book', name: 'The Bhagavad Gita', url: `${site}/gita` },
    about: chapter.theme,
    ...(ci?.intro ? { abstract: ci.intro } : {}),
  },
];
---

<Base title={title} description={description} schema={schema}>
  <article class="wrap reader" data-lang="en" id="reader">
    <div class="reader-head">
      <nav class="breadcrumb">
        <a href={withBase('')}>Home</a> › <a href={withBase('gita')}>Read the Gita</a> › Chapter {chapter.number}
      </nav>
      <div class="wordmark-deva">{chapter.title}</div>
      <h1>Chapter {chapter.number} · {chapter.en}</h1>
      <p>{chapter.theme} · {chapter.verseCount} verses</p>

      <div class="lang-toggle" role="group" aria-label="Translation language">
        <button type="button" data-set-lang="en" aria-pressed="true">English</button>
        <button type="button" data-set-lang="hi" aria-pressed="false">हिन्दी</button>
        <button type="button" data-set-lang="ne" aria-pressed="false">नेपाली</button>
      </div>
    </div>

    {ci && (
      <div class="chapter-intro">
        <p>{ci.intro}</p>
        {ci.keyVerses?.length > 0 && (
          <div class="key-verses">
            <h2>Key verses in this chapter</h2>
            <ul>
              {ci.keyVerses.map((k) => (
                <li>
                  <a href={withBase(`gita/${chapter.number}/${k.n}`)}>Gita {chapter.number}.{k.n}</a>
                  <span> — {k.note}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    <div class="verses">
      {chapter.verses.map((v) => (
        <section class="verse" id={`v${v.number}`}>
          <div class="verse-num"><a href={withBase(`gita/${chapter.number}/${v.number}`)}>{chapter.number}.{v.number}</a></div>
          <p class="sanskrit" lang="sa">{v.sanskrit}</p>

          {v.en && <p class="meaning" data-tr="en" lang="en">{v.en}</p>}
          {v.hi && <p class="meaning deva" data-tr="hi" lang="hi">{v.hi}</p>}
          {v.ne && <p class="meaning deva" data-tr="ne" lang="ne">{v.ne}</p>}

          {v.enBy && <p class="byline" data-tr="en">— {v.enBy}</p>}
          {v.hiBy && <p class="byline" data-tr="hi">— {v.hiBy}</p>}
          {v.neBy && <p class="byline" data-tr="ne">— {v.neBy}</p>}

          {v.contextEn && (
            <div class="context" data-tr="en"><span class="label">Context</span><p lang="en">{v.contextEn}</p></div>
          )}
          {v.contextHi && (
            <div class="context" data-tr="hi"><span class="label">संदर्भ</span><p class="deva" lang="hi">{v.contextHi}</p></div>
          )}
          {v.contextNe && (
            <div class="context" data-tr="ne"><span class="label">सन्दर्भ</span><p class="deva" lang="ne">{v.contextNe}</p></div>
          )}
        </section>
      ))}
    </div>

    <div class="app-cta">
      <h3>Carry a verse with you</h3>
      <p>Save the verses that speak to you, get a verse each day, and read by how you feel — in the Gita Daily app.</p>
      <span class="btn btn-primary" aria-disabled="true">Coming soon to Google Play</span>
    </div>

    <nav class="chapter-nav">
      {prev ? (
        <a href={withBase(`gita/${prev.number}`)}>
          <span class="dir">← Previous</span><span class="name">{prev.number}. {prev.en}</span>
        </a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a class="nx" href={withBase(`gita/${next.number}`)}>
          <span class="dir">Next →</span><span class="name">{next.number}. {next.en}</span>
        </a>
      ) : (
        <span></span>
      )}
    </nav>
  </article>

  <script is:inline>
    (function () {
      var r = document.getElementById('reader');
      var btns = document.querySelectorAll('[data-set-lang]');
      var KEY = 'gita_lang';
      function set(lang) {
        r.setAttribute('data-lang', lang);
        btns.forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-set-lang') === lang));
        });
        try { localStorage.setItem(KEY, lang); } catch (e) {}
      }
      btns.forEach(function (b) {
        b.addEventListener('click', function () { set(b.getAttribute('data-set-lang')); });
      });
      try { var s = localStorage.getItem(KEY); if (s && s !== 'en') set(s); } catch (e) {}
    })();
  </script>
</Base>
