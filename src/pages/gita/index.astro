---
import Base from '../../layouts/Base.astro';
import data from '../../data/gita.json';

const base = import.meta.env.BASE_URL;
const withBase = (p = '') => (base.endsWith('/') ? base : base + '/') + p;

const sections = [
  { label: 'The Way of Action', deva: 'कर्ममार्ग', range: [1, 6] },
  { label: 'The Way of Devotion', deva: 'भक्तिमार्ग', range: [7, 12] },
  { label: 'The Way of Knowledge', deva: 'ज्ञानमार्ग', range: [13, 18] },
];
const chapters = data.chapters;
const totalVerses = chapters.reduce((n, c) => n + c.verseCount, 0);

const site = (Astro.site?.href ?? 'https://gitadaily.org/').replace(/\/$/, '');

const faqs = [
  {
    q: 'How many chapters are in the Bhagavad Gita?',
    a: `The Bhagavad Gita has 18 chapters, containing ${totalVerses} verses in total. You can read all of them free on Gita Daily.`,
  },
  {
    q: 'How many verses are in the Bhagavad Gita?',
    a: `Gita Daily includes ${totalVerses} verses across the 18 chapters (some traditions count 700). Each verse has the original Sanskrit plus translations.`,
  },
  {
    q: 'Can I read the Bhagavad Gita for free?',
    a: 'Yes. The complete Bhagavad Gita is free to read on gitadaily.org — no account, no paywall on the scripture, ever.',
  },
  {
    q: 'What languages is the Bhagavad Gita available in here?',
    a: 'Every verse is available in English, Hindi (हिन्दी) and Nepali (नेपाली), alongside the original Sanskrit, with context for each verse.',
  },
  {
    q: 'What is the Bhagavad Gita about?',
    a: 'The Bhagavad Gita is a 700-verse dialogue between Prince Arjuna and Krishna on the battlefield of Kurukshetra, exploring duty (dharma), action without attachment, devotion, and the nature of the self.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: 'The Bhagavad Gita',
    alternateName: 'Śrīmad Bhagavad Gītā',
    url: `${site}/gita`,
    inLanguage: ['sa', 'en', 'hi', 'ne'],
    numberOfPages: chapters.length,
    genre: 'Hindu scripture',
    about: 'A dialogue on duty, action, devotion and the nature of the self.',
    hasPart: chapters.map((c) => ({
      '@type': 'CreativeWork',
      position: c.number,
      name: `Chapter ${c.number}: ${c.en}`,
      url: `${site}/gita/${c.number}`,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Read the Gita', item: `${site}/gita` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base
  title="Read the Bhagavad Gita — all 18 chapters, free | Gita Daily"
  description="Read the complete Bhagavad Gita free online — all 18 chapters and 701 verses, with the original Sanskrit and translations in English, Hindi and Nepali."
  schema={schema}
>
  <article class="wrap reader">
    <div class="reader-head">
      <nav class="breadcrumb"><a href={withBase('')}>Home</a> › Read the Gita</nav>
      <div class="wordmark-deva">श्रीमद्भगवद्गीता</div>
      <h1>The Bhagavad Gita</h1>
      <p>
        The complete text — all <strong>18 chapters</strong> and <strong>{totalVerses} verses</strong> —
        free to read, in the original Sanskrit with English, Hindi (हिन्दी) and Nepali (नेपाली)
        translations and context for every verse.
      </p>
    </div>

    {sections.map((s) => (
      <div>
        <div class="section-band">
          <h2>{s.label} <span class="deva-tag">{s.deva}</span></h2>
          <p>Chapters {s.range[0]}–{s.range[1]}</p>
        </div>
        <div class="ch-list">
          {chapters
            .filter((c) => c.number >= s.range[0] && c.number <= s.range[1])
            .map((c) => (
              <a class="ch-card" href={withBase(`gita/${c.number}`)}>
                <span class="ch-num">{c.number}</span>
                <span>
                  <span class="en">{c.en}</span>
                  <span class="deva">{c.title}</span>
                  <span class="theme">{c.theme} · {c.verseCount} verses</span>
                </span>
              </a>
            ))}
        </div>
      </div>
    ))}

    <div class="app-cta">
      <h3>Make it a daily practice</h3>
      <p>
        The Gita Daily app meets you where you are — start from a mood, get a verse for the moment,
        save what moves you, and keep a gentle daily streak.
      </p>
      <span class="btn btn-primary" aria-disabled="true">Coming soon to Google Play</span>
    </div>

    <section class="faq" aria-labelledby="faq-title">
      <h2 id="faq-title">Frequently asked questions</h2>
      {faqs.map((f) => (
        <div class="faq-item">
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </div>
      ))}
    </section>
  </article>
</Base>
