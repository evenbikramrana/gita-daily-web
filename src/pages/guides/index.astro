---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
const withBase = (p = '') => (base.endsWith('/') ? base : base + '/') + p;
const site = (Astro.site?.href ?? 'https://gitadaily.org/').replace(/\/$/, '');

// Registry of guides — add an entry here when you publish a new one.
export const guides = [
  {
    slug: 'bhagavad-gita-in-nepali',
    title: 'Read the Bhagavad Gita in Nepali (नेपाली)',
    blurb: 'Every verse of the Gita in Nepali, with the Sanskrit beside it and context for each — free, and switchable to Hindi or English.',
  },
  {
    slug: 'bhagavad-gita-on-anxiety',
    title: 'What the Bhagavad Gita says about anxiety',
    blurb: 'When the mind races and the outcome grips you — the verses the Gita offers for anxious moments, and how to read them.',
  },
  {
    slug: 'bhagavad-gita-on-death-and-grief',
    title: 'What the Bhagavad Gita says about death and grief',
    blurb: 'The Gita begins with a man grieving — and answers him. What it teaches about death, loss and the self that does not die.',
  },
  {
    slug: 'bhagavad-gita-on-depression',
    title: 'What the Bhagavad Gita says about depression and despair',
    blurb: 'Its first chapter is named for one man’s collapse. What the Gita offers when you feel low, hopeless or unable to go on.',
  },
  {
    slug: 'bhagavad-gita-on-fear',
    title: 'What the Bhagavad Gita says about fear',
    blurb: 'Fear as the mind pulled out of the present by what it dreads — and a steadiness that doesn’t wait for the danger to pass.',
  },
  {
    slug: 'bhagavad-gita-on-overthinking',
    title: 'What the Bhagavad Gita says about overthinking',
    blurb: 'The mind “as hard to hold as the wind” — and the Gita’s patient, surprisingly modern method for a mind that won’t stop.',
  },
  {
    slug: 'bhagavad-gita-on-work-and-stress',
    title: 'What the Bhagavad Gita says about work and stress',
    blurb: 'Karma yoga: do your work fully and well, release your grip on the result, and let the job steady you instead of fraying you.',
  },
  {
    slug: 'bhagavad-gita-on-forgiveness',
    title: 'What the Bhagavad Gita says about forgiveness',
    blurb: 'Forgiveness (kshama) as a mark of strength, not weakness — the verses on forgiving others, and on being forgiven.',
  },
  {
    slug: 'bhagavad-gita-on-love',
    title: 'What the Bhagavad Gita says about love and relationships',
    blurb: 'The sharp line the Gita draws between love and attachment — and between possessing someone and truly seeing them.',
  },
  {
    slug: 'bhagavad-gita-for-beginners',
    title: 'The Bhagavad Gita for beginners: where to start',
    blurb: 'New to the Gita? A gentle map of what it is, which chapters to read first, and the one verse to begin with.',
  },
  {
    slug: 'bhagavad-gita-on-anger',
    title: 'What the Bhagavad Gita says about anger',
    blurb: 'The Gita traces exactly how anger takes hold — and how to loosen its grip. The key verses, explained.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Gita Daily Guides',
    url: `${site}/guides`,
    description: 'Plain-language guides to the Bhagavad Gita — what it teaches about anxiety, anger, purpose and more, with the verses to read.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Guides', item: `${site}/guides` },
    ],
  },
];
---

<Base
  title="Guides to the Bhagavad Gita — Gita Daily"
  description="Plain-language guides to the Bhagavad Gita: what it teaches about anxiety, anger, purpose and where to begin — each with the verses to read."
  schema={schema}
>
  <section class="wrap prose">
    <h1>Guides to the Bhagavad Gita</h1>
    <p class="updated">Short, plain-language reads — each pointing you to the verses themselves.</p>
    <div class="guide-list">
      {guides.map((g) => (
        <a class="guide-card" href={withBase(`guides/${g.slug}`)}>
          <h2>{g.title}</h2>
          <p>{g.blurb}</p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
  .guide-list { display: grid; gap: 0; margin-top: var(--s6); }
  .guide-card {
    display: block;
    padding: var(--s6) 0;
    border: 0;
    border-top: 1.5px solid var(--line-strong);
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  .guide-card:hover { text-decoration: none; }
  .guide-card:hover h2 { color: var(--accent); }
  .guide-card h2 { margin: 0 0 var(--s2); font-size: 1.6rem; color: var(--ink); transition: color 0.15s ease; }
  .guide-card p { margin: 0; color: var(--muted); line-height: 1.6; max-width: 62ch; }
</style>
