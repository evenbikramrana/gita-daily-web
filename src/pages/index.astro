---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import data from '../data/gita.json';

const base = import.meta.env.BASE_URL;
const withBase = (p = '') => (base.endsWith('/') ? base : base + '/') + p;
const site = (Astro.site?.href ?? 'https://gitadaily.org/').replace(/\/$/, '');

// A well-known verse to feature on the page (Gita 2.47 — act, release the fruit).
const featured = data.chapters.find((c) => c.number === 2)?.verses.find((v) => v.number === 47);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Gita Daily',
    alternateName: ['Gita Daily app', 'gitadaily.org'],
    slogan: 'The Bhagavad Gita, led by how you feel',
    description:
      'Gita Daily is a mood-led companion to the Bhagavad Gita — read the whole Gita free in English, Hindi and Nepali, start from how you feel, and build a gentle daily reading practice.',
    url: site,
    logo: `${site}/og.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Gita Daily',
    alternateName: 'Gita Daily — mood-led Bhagavad Gita',
    description:
      'The mood-led Bhagavad Gita companion at gitadaily.org — the whole Gita free in English, Hindi and Nepali, with a daily verse and mood-based verse discovery.',
    url: site,
    inLanguage: ['en', 'hi', 'ne'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'MobileApplication',
    name: 'Gita Daily',
    alternateName: 'Gita Daily: Bhagavad Gita',
    operatingSystem: 'ANDROID',
    applicationCategory: 'LifestyleApplication',
    slogan: 'The Bhagavad Gita, led by how you feel',
    description:
      'A mood-led Bhagavad Gita companion — read the whole Gita free in English, Hindi and Nepali, with a daily verse, saved verses, streaks and gentle reminders.',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
];

const features = [
  { icon: 'compass', title: 'Led by how you feel', body: 'Start from a mood — anxious, restless, grateful, lost — and meet a verse chosen for that moment.' },
  { icon: 'book', title: 'The whole Gita, free', body: 'All 18 chapters and 701 verses, always free to read. No paywall on the scripture, ever.' },
  { icon: 'globe', title: 'Trilingual', body: 'Read every verse in English, Hindi (हिन्दी) and Nepali (नेपाली), with context for each.' },
  { icon: 'sun', title: 'A verse each day', body: 'A featured verse of the day, with a gentle daily reminder if you want one.' },
  { icon: 'bookmark', title: 'Save & build a streak', body: 'Keep the verses that stay with you, and watch a quiet reading streak grow.' },
  { icon: 'leaf', title: 'Calm by design', body: 'A warm, unhurried reading space — no ads, no noise, no pressure.' },
];
---

<Base
  title="Gita Daily — the mood-led Bhagavad Gita companion"
  description="Gita Daily (gitadaily.org) is the mood-led Bhagavad Gita companion — read the whole Gita free in English, Hindi and Nepali, start from how you feel, get a daily verse, and build a gentle reading streak."
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <svg class="hero-lotus reveal" viewBox="0 0 100 100" aria-hidden="true">
        <path d="M50 78 C36 60 30 42 22 46 C26 64 38 74 50 78 Z" fill="#4E8F86" />
        <path d="M50 78 C64 60 70 42 78 46 C74 64 62 74 50 78 Z" fill="#4E8F86" />
        <path d="M50 78 C42 56 44 34 50 26 C56 34 58 56 50 78 Z" fill="#E5731F" />
      </svg>
      <span class="eyebrow reveal" style="--d:60ms">The Bhagavad Gita, for how you feel</span>
      <div class="wordmark-deva reveal" style="--d:120ms">श्रीमद्भगवद्गीता</div>
      <h1 class="reveal" style="--d:180ms">Gita Daily</h1>
      <p class="lede reveal" style="--d:240ms">
        A calm, mood-led companion to the Bhagavad Gita. Begin with what you're feeling —
        and let the verse meet you there. Free to read, in three languages.
      </p>
      <div class="btns reveal" style="--d:320ms">
        <a class="btn btn-primary" href={withBase('gita')}>Read the Gita free</a>
        <span class="btn btn-ghost" aria-disabled="true">App coming soon to Google Play</span>
      </div>
    </div>
  </section>

  {featured && (
    <section class="verse-band">
      <div class="wrap">
        <figure class="verse-hero reveal">
          <p class="verse-hero-sa" lang="sa">{featured.sanskrit}</p>
          <div class="danda" aria-hidden="true">॥</div>
          <blockquote class="verse-hero-en">{featured.en}</blockquote>
          <figcaption class="verse-hero-ref">Bhagavad Gītā · 2.47</figcaption>
        </figure>
      </div>
    </section>
  )}

  <div class="wrap"><div class="ornament reveal" aria-hidden="true"><svg viewBox="0 0 100 100"><path d="M50 78 C36 60 30 42 22 46 C26 64 38 74 50 78 Z" fill="currentColor"/><path d="M50 78 C64 60 70 42 78 46 C74 64 62 74 50 78 Z" fill="currentColor"/><path d="M50 78 C42 56 44 34 50 26 C56 34 58 56 50 78 Z" fill="currentColor" opacity="0.55"/></svg></div></div>

  <section id="features" class="section">
    <div class="wrap">
      <div class="section-intro reveal">
        <h2>What's inside</h2>
        <p>A calm place to read the Gita — and a daily practice to keep returning to it.</p>
      </div>
      <div class="features">
        {features.map((f, i) => (
          <article class="card reveal" style={`--d:${i * 70}ms`}>
            <span class="ic-wrap"><Icon name={f.icon} size={24} /></span>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <div class="wrap"><div class="ornament reveal" aria-hidden="true"><svg viewBox="0 0 100 100"><path d="M50 78 C36 60 30 42 22 46 C26 64 38 74 50 78 Z" fill="currentColor"/><path d="M50 78 C64 60 70 42 78 46 C74 64 62 74 50 78 Z" fill="currentColor"/><path d="M50 78 C42 56 44 34 50 26 C56 34 58 56 50 78 Z" fill="currentColor" opacity="0.55"/></svg></div></div>

  <section class="section">
    <div class="wrap">
      <div class="section-intro reveal">
        <h2>Free, always</h2>
        <p>
          The Gita has been shared freely for millennia — and Gita Daily keeps it that way. The full
          scripture is free to read forever. A gentle guided companion is on the way for those who
          want to go deeper, but the text itself will never sit behind a paywall.
        </p>
      </div>
    </div>
  </section>
</Base>
