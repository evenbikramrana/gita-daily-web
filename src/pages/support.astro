---
import Base from '../layouts/Base.astro';
const email = 'hello@gitadaily.org';
const base = import.meta.env.BASE_URL;
const withBase = (p = '') => (base.endsWith('/') ? base : base + '/') + p;

const faqs = [
  { q: 'Is Gita Daily free?', a: 'Yes. The full Bhagavad Gita — all 18 chapters and 701 verses — is free to read, always. A deeper guided companion is planned as an optional extra, but the scripture itself will never be behind a paywall.' },
  { q: 'Which languages are supported?', a: 'Every verse is available in English, Hindi (हिन्दी) and Nepali (नेपाली), each with context. You can switch language any time while reading.' },
  { q: 'How do daily reminders work?', a: 'You can turn on a gentle daily reminder and pick a time in Settings. Reminders are scheduled on your device — turn them off any time.' },
  { q: 'How do I save verses and build a streak?', a: 'Tap the heart on any verse to save it to your collection. Reading each day quietly grows your streak — no pressure, just a gentle nudge to return.' },
  { q: 'I’m having trouble signing in.', a: 'Make sure you’re connected to the internet and using the same email or Google/Apple account you signed up with. If it still won’t work, email us and we’ll help.' },
  { q: 'How do I delete my account or data?', a: 'You can delete your account and all associated data right in the app — Settings › Account › Delete account. Or email us from the address on your account and we’ll do it for you. See the Privacy Policy for details.' },
];

const site = (Astro.site?.href ?? 'https://gitadaily.org/').replace(/\/$/, '');
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site },
      { '@type': 'ListItem', position: 2, name: 'Support', item: `${site}/support` },
    ],
  },
];
---

<Base
  title="Support — Gita Daily"
  description="Help with Gita Daily: FAQs on languages, reminders, saving verses, accounts, and how to contact us."
  schema={schema}
>
  <section class="wrap support">
    <header class="support-head reveal">
      <h1>Support</h1>
      <p class="sub">We're a small project, and happy to help.</p>
    </header>

    <div class="contact-card reveal" style="--d:80ms">
      <span class="cc-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
        </svg>
      </span>
      <div>
        <p class="cc-title">Email us</p>
        <p class="cc-body">
          The quickest way to reach us is <a href={`mailto:${email}`}>{email}</a>. We usually reply
          within a few days.
        </p>
      </div>
    </div>

    <h2 class="faq-title reveal">Frequently asked questions</h2>
    <div class="faq-grid">
      {faqs.map((f, i) => (
        <article class="faq-card reveal" style={`--d:${120 + i * 60}ms`}>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </article>
      ))}
    </div>

    <div class="help-cta reveal">
      <h2>Still need help?</h2>
      <p>
        Email <a href={`mailto:${email}`}>{email}</a> with your question and, if it's about a bug,
        the device you're using. You can also review our
        <a href={withBase('privacy')}>Privacy Policy</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .support {
    max-width: var(--content);
    padding-top: var(--s7);
    padding-bottom: var(--s8);
  }
  .support-head h1 { margin-bottom: 0.15em; }
  .support-head .sub { color: var(--muted); margin: 0 0 var(--s6); font-size: 1.1rem; }

  /* Contact panel — bordered editorial block with a solid accent icon. */
  .contact-card {
    display: flex;
    gap: var(--s4);
    align-items: flex-start;
    padding: var(--s5);
    border: 1.5px solid var(--line-strong);
    border-radius: var(--radius);
    background: none;
    margin-bottom: var(--s7);
  }
  .cc-icon {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: var(--radius-sm);
    display: grid;
    place-items: center;
    background: var(--accent);
    color: #fff;
  }
  .cc-title {
    margin: 0 0 4px;
    font-family: var(--display);
    font-weight: 700;
    color: var(--ink);
    font-size: 1.1rem;
  }
  .cc-body { margin: 0; color: var(--ink-soft); line-height: 1.6; }

  .faq-title { margin-bottom: var(--s2); }

  /* FAQ as hairline-ruled editorial rows. */
  .faq-grid { display: grid; gap: 0; }
  .faq-card {
    padding: var(--s5) 0;
    border: 0;
    border-top: 1.5px solid var(--line-strong);
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  .faq-card h3 {
    margin: 0 0 var(--s2);
    color: var(--ink);
    font-size: 1.15rem;
    line-height: 1.3;
  }
  .faq-card p { margin: 0; color: var(--muted); line-height: 1.65; }

  /* Closing call-to-action — bold ink block. */
  .help-cta {
    margin-top: var(--s7);
    padding: var(--s6);
    border-radius: var(--radius);
    background: var(--ink-block);
    border: 0;
    color: var(--on-ink);
  }
  .help-cta h2 { margin: 0 0 var(--s2); color: var(--on-ink); }
  .help-cta p { margin: 0; max-width: 60ch; color: var(--on-ink-soft); line-height: 1.6; }
  .help-cta a { color: var(--accent); border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent); }
  .help-cta a:hover { border-bottom-color: var(--accent); }

  @media (max-width: 520px) {
    .contact-card { flex-direction: column; gap: var(--s3); }
  }
</style>
